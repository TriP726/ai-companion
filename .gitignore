# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Test and build residue
.pytest_cache/
build/
dist/

# Large artifacts that must never be committed. All of these are
# regenerated on demand:
#   models/        -> tools/get_model.py / tools/get_speech.py
#   voice_samples/ -> tools/audition_voices.py
models/
voice_samples/
*.zip
*.wav
*.part

# Screenshots taken while verifying UI work
*.png
!assets/*.png

# Local runtime state — created on demand at first launch
config.json
config.json.tmp
config.json.broken-*
data/
workspace/
uploads/
sandbox3d/
sandbox/
vault/
generated_images/

# Stray environment markers
.sudo_as_admin_successful
